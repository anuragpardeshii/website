    "api": "node scripts/workspace-command.mjs backend dev",
    "import:legacy": "node scripts/workspace-command.mjs backend import:legacy",
    "test:crm-pages": "node tests/crm-pages.mjs",
    "test:table-actions": "node tests/table-actions.mjs",
    "test:notifications": "node tests/notifications.mjs",
    "test:dev": "node --test tests/dev-config.test.mjs",
    "test:dev-startup": "node tests/dev-startup.mjs",
    "test:crm-ui": "node tests/crm-ui.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=24"
  }
