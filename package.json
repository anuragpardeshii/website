{
  "name": "sleektech-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "crm",
    "careers",
    "backend",
    "shared/ui"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm test --workspace @sleektech/backend",
    "test:browser": "node tests/browser.mjs",
    "test:marketing": "node tests/marketing.mjs",
    "migrate": "node scripts/workspace-command.mjs backend migrate",
    "migrate:status": "node scripts/workspace-command.mjs backend migrate:status",
