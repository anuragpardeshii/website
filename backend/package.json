{
  "name": "@sleektech/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env.local src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "migrate": "node --env-file-if-exists=.env.local src/migrate.mjs",
    "migrate:status": "node --env-file-if-exists=.env.local src/migrate.mjs --status",
    "admin": "node --env-file-if-exists=.env.local src/admin.mjs",
    "import:legacy": "node --env-file-if-exists=.env.local scripts/import-legacy.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mammoth": "^1.11.0",
    "mongodb": "^7.0.0",
    "multer": "2.5.0",
    "pdf-parse": "2.4.5",
    "svix": "^1.84.1",
    "ws": "^8.22.1",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "chokidar": "^6.0.0"
  }
}
